import json, os, datetime
from jinja2 import Template

REPORT_TEMPLATE = """
# Global Harmony Report – {{ date }}

## KPIs
- **Fläche aktiv**: {{ area }} ha
- **Resonanz U**: {{ u }} Hz (ΔU = {{ delta_u }} Hz)
- **Myzel‑Signal**: {{ myzel }} (≥ 0.85)
- **pH‑Durchschnitt**: {{ ph }} (6.5 ± 0.3)

## Reputation‑Durchschnitt
{{ reputation_table }}

*Report anchored on IPFS:* {{ ipfs_cid }}
"""

def generate():
    # Laden von Telemetrie‑Aggregaten (pseudo‑API‑Call)
    data = json.loads(open("/var/lib/vacuum/telemetry_summary.json").read())
    rep = json.loads(open("/etc/vacuum/reputation.json").read())

    reputation_rows = "\n".join(
        f"| {nid} | {round(w,2)} |" for nid, w in rep.items()
    )
    rep_table = f"| Node | Weight |\n|------|--------|\n{reputation_rows}"

    rendered = Template(REPORT_TEMPLATE).render(
        date=datetime.datetime.utcnow().strftime("%Y-%m-%d %H:%M UTC"),
        area=data["area_ha"],
        u=data["resonance_u"],
        delta_u=abs(data["resonance_u"] - 1088.20),
        myzel=round(data["myzel_avg"], 3),
        ph=round(data["ph_avg"], 3),
        reputation_table=rep_table,
        ipfs_cid="pending"  # wird nach Anchor ersetzt
    )

    # Write temporary file
    path = "/tmp/ghp_report.md"
    with open(path, "w") as f:
        f.write(rendered)

    # Anchor on IPFS
    from vacuum_node.ipfs_anchor import anchor_ipfs
    cid = anchor_ipfs(open(path, "rb").read(), "/report/24h")
    # Ersetze Platzhalter
    with open(path, "r") as f:
        content = f.read().replace("pending", cid)
    with open(path, "w") as f:
        f.write(content)

    print(f"Report generated and anchored: {cid}")

if __name__ == "__main__":
    generate()
