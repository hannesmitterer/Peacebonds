{
  "index_patterns": ["vcd01-security-*"],
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 3,
        "number_of_replicas": 1,
        "refresh_interval": "5s"
      }
    },
    "mappings": {
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "source_ip": {
          "type": "ip"
        },
        "dest_ip": {
          "type": "ip"
        },
        "source_port": {
          "type": "integer"
        },
        "dest_port": {
          "type": "integer"
        },
        "protocol": {
          "type": "keyword"
        },
        "event_type": {
          "type": "keyword"
        },
        "severity": {
          "type": "keyword"
        },
        "message": {
          "type": "text"
        },
        "payload_hash": {
          "type": "keyword"
        },
        "packet_size": {
          "type": "integer"
        },
        "suspicious": {
          "type": "boolean"
        },
        "threat_intel": {
          "properties": {
            "reputation": {
              "type": "integer"
            },
            "abuse_score": {
              "type": "integer"
            },
            "asn": {
              "type": "keyword"
            },
            "country": {
              "type": "keyword"
            }
          }
        }
      }
    }
  }
}
